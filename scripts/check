#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
qml_linter="/usr/lib/qt6/bin/qmllint"

if [[ ! -x "$qml_linter" ]]; then
    qml_linter="$(command -v qmllint6 || command -v qmllint)"
fi

"$qml_linter" \
    "$project_dir/qml/packs/critter/Critter.qml" \
    "$project_dir/qml/packs/vines/Leaf.qml" \
    "$project_dir/qml/packs/vines/VineFrame.qml" \
    "$project_dir/qml/Study.qml" \
    "$project_dir/qml/Main.qml" \
    "$project_dir/qml/Capture.qml"

# `qs.*` modules are resolved by Quickshell's runtime loader rather than Qt's
# standalone import scanner. Keep syntax/type checks for the local components
# without flooding the check with false missing-import errors for Omarchy UI.
"$qml_linter" \
    --import disable \
    --inheritance-cycle disable \
    --unresolved-type disable \
    --missing-type disable \
    --unqualified disable \
    --unused-imports disable \
    --signal-handler-parameters disable \
    "$project_dir/shell/OmaFramesIcon.qml" \
    "$project_dir/shell/Service.qml" \
    "$project_dir/shell/Panel.qml"

if command -v omarchy >/dev/null 2>&1; then
    omarchy plugin validate "$project_dir/shell"
fi

make -C "$project_dir/native" clean all

for symbol in pluginAPIVersion pluginInit pluginExit; do
    if ! nm -D --defined-only "$project_dir/native/omaframes-native.so" | rg --quiet "[[:space:]]${symbol}$"; then
        printf 'missing required plugin export: %s\n' "$symbol" >&2
        exit 1
    fi
done
